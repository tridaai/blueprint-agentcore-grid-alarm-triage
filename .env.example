# --- AWS / Bedrock profile (production: AgentCore Runtime) --------
# Region the Bedrock model and AgentCore resources live in.
AWS_REGION=us-east-1
# Bedrock model id for the `bedrock` model profile (Strands
# BedrockModel). Example: a Claude model on Bedrock.
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
# Model profile: offline (default, deterministic, no account needed)
# or bedrock (refuses loudly until the account is wired).
GRID_MODEL_PROFILE=offline

# --- Stores --------------------------------------------------------
# SQLite local default:
SQLITE_PATH=./data/grid.db
OBJECT_STORE_DIR=./data/objects
# PostgreSQL (production store) — set to switch the store port:
# DATABASE_URL=postgresql://grid:grid@localhost:5432/grid

# --- Topology -------------------------------------------------------
TOPOLOGY_VERSION=v1

# --- Runtime --------------------------------------------------------
RUNTIME_PORT=8080
